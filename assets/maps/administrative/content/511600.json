    "poi:admin:511600:5495c1c1": {
      "label": {
        "en": "Guang'an White Pagoda",
        "zh-CN": "广安白塔",
        "zh-TW": "廣安白塔"
      },
      "description": {
        "en": "The White Pagoda stands in Guang'an District, Sichuan. The historic tower dates to the Song period and is protected as a provincial monument.",
        "zh-CN": "广安白塔位于四川省广安市广安区，文物遗址年代判定为宋。1980年7月7日列为四川省重新确定公布的第一批省级文物保护单位。",
        "zh-TW": "廣安白塔位於四川省廣安市廣安區，文物遺址年代判定為宋。1980年7月7日列為四川省重新確定公佈的第一批省級文物保護單位。"
      },
