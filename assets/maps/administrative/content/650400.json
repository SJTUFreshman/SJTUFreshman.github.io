    "poi:admin:650400:c36e6800": {
      "label": {
        "en": "Turpan Museum",
        "zh-CN": "吐鲁番博物馆",
        "zh-TW": "吐魯番博物館"
      },
      "description": {
        "en": "Turpan Museum is a museum in Turpan, Xinjiang, China. It has items from the Tang dynasty excavated from the Astana Graves which are located outside the town.",
        "zh-CN": "吐鲁番博物馆，位于中华人民共和国新疆维吾尔自治区吐鲁番市高昌区木纳尔路，是吐鲁番市属综合性博物馆。是国家一级博物馆、国家AAAA级旅游景区、2021-2025年第一批全国科普教育基地。",
        "zh-TW": "吐魯番博物館，位於中華人民共和國新疆維吾爾自治區吐魯番市高昌區木納爾路，是吐魯番市屬綜合性博物館。是國家一級博物館、國家AAAA級旅遊景區、2021-2025年第一批全國科普教育基地。"
      },
      "source": "https://zh.wikipedia.org/wiki/%E5%90%90%E9%B2%81%E7%95%AA%E5%8D%9A%E7%89%A9%E9%A6%86",
