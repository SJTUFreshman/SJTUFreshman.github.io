    "poi:admin:TW-HSZ:98d5c642": {
      "label": {
        "en": "Tomb of Zheng Yongxi",
        "zh-CN": "郑用锡墓",
        "zh-TW": "鄭用錫墓"
      },
      "description": {
        "en": "Zheng Yongxi's tomb stands in eastern Hsinchu beside the military cemetery. Relocated here in 1869, the elaborate official's tomb is a nationally designated monument.",
        "zh-CN": "郑用锡墓，今位于台湾新竹市东区新竹市军人公墓旁，同治八年从香山区迁葬于此，具有官墓规模，今列国定古迹。",
        "zh-TW": "鄭用錫墓，今位於臺灣新竹市東區新竹市軍人公墓旁，同治八年從香山區遷葬於此，具有官墓規模，今列國定古蹟。"
      },
      "source": "https://zh.wikipedia.org/wiki/%E9%84%AD%E7%94%A8%E9%8C%AB%E5%A2%93",
      "textSources": [
