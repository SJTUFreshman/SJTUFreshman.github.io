  <tag k="admin_level" v="2"/>
  <tag k="boundary" v="administrative"/>
  <tag k="maritime" v="yes"/>
  <tag k="name" v="金門地區限制水域"/>
  <tag k="name:en" v="Kinmen Area Restricted Waters"/>
  <tag k="name:nan" v="Kim-mn̂g Tōe-khu Hān-chè Chúi-he̍k"/>
  <tag k="name:nan-Hant" v="金門地區限制水域"/>
  <tag k="name:nan-Latn-pehoeji" v="Kim-mn̂g Tōe-khu Hān-chè Chúi-he̍k"/>
  <tag k="name:nan-Latn-tailo" v="Kim-mn̂g Tuē-khu Hān-tsè Tsuí-hi̍k"/>
  <tag k="name:zh" v="金門地區限制水域"/>
  <tag k="name:zh-Hans" v="金门地区限制水域"/>
  <tag k="name:zh-Hant" v="金門地區限制水域"/>
  <tag k="note:en:1" v="This is a unilateral boundary established by Taiwan under the Act Governing Relations between the People of the Taiwan Area and the Mainland Area and it is only intended to restrict vessels from the Mainland."/>
  <tag k="note:en:2" v="It is not established under the Law on the Territorial Sea and the Contiguous Zone of the Republic of China or the United Nations Convention on the Law of the Sea. It does not constitute a Territorial Sea delimitation."/>
  <tag k="note:en:3" v="The mainland authorities have denied the existence of this boundary."/>
  <tag k="note:zh-Hans" v="此为台湾方面根据其制定的《台湾地区与大陆地区人民关系条例》单方面划定的边界，旨在限制大陆船舶进入该水域。此边界的划定不涉及《中华民国领海及邻接区法》或《联合国海洋法公约》，亦不涉及领海划界。大陆当局否认限制水域的存在。"/>
  <tag k="note:zh-Hant" v="此為台灣方面根據其製定的《台灣地區與大陸地區人民關係條例》單方面劃定的邊界，旨在限制大陸船舶進入該水域。此邊界的劃定不涉及《中華民國領海及鄰接區法》或《聯合國海洋法公約》，亦不涉及領海劃界。大陸當局否認限制水域的存在。"/>
  <tag k="source" v="https://www.cpami.gov.tw/kids/filesys/file/chinese/new5/0930001493.pdf"/>
 </way>
